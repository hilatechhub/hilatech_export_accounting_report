<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Ajoute le bouton Export Excel aux wizards qui partagent la vue
         commune account_report_view_form (modèle account.report).
         On hérite de la vue spécifique de chaque wizard pour que la
         validation de vue se fasse sur le bon modèle (qui définit
         bien la méthode action_export_xlsx). -->

    <!-- Trial Balance -->
    <record id="account_report_balance_view_inherit_xlsx" model="ir.ui.view">
        <field name="name">account.balance.report.view.form.inherit.xlsx</field>
        <field name="model">account.balance.report</field>
        <field name="inherit_id"
               ref="base_accounting_kit.account_report_balance_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='check_report']" position="after">
                <button string="Export Excel"
                        name="action_export_xlsx"
                        type="object"
                        class="btn-success"
                        icon="fa-file-excel-o"/>
            </xpath>
        </field>
    </record>

