<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Hérite du formulaire wizard Profit & Loss / Balance Sheet
         pour ajouter le bouton Export Excel à côté de Print. -->
    <record id="financial_report_view_form_inherit_xlsx" model="ir.ui.view">
        <field name="name">financial.report.view.form.inherit.xlsx</field>
        <field name="model">financial.report</field>
        <field name="inherit_id"
               ref="base_accounting_kit.financial_report_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@name='view_report_pdf']"
                   position="after">
                <button string="Export Excel"
                        name="action_export_xlsx"
                        type="object"
                        class="btn-success"
                        icon="fa-file-excel-o"/>
            </xpath>
        </field>
    </record>
</odoo>
